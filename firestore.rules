rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // profile + aura: any signed-in user can read (leaderboard, search); only the owner writes
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // private to the owner
      match /goals/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /following/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // shared achievements: readable by signed-in users, written only by the owner
      match /posts/{id} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;

        // props: one doc per giver, id = the giver's uid; readable by signed-in users
        match /props/{giver} {
          allow read: if request.auth != null;
          allow create, delete: if request.auth != null && request.auth.uid == giver;
        }
      }
    }
  }
}
