rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // profile + aura: any signed-in user can read (leaderboard, search); only the owner writes
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // private to the owner
      match /goals/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /following/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // aura sent by other people (gave / helped): the id is fixed per giver and post, so it cannot be created twice
      match /gifts/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && uid != request.auth.uid
          && request.resource.data.points in [5, 10];
        allow delete: if request.auth != null
          && (resource.data.from == request.auth.uid || request.auth.uid == uid);
      }
    }

    // the forum: done and ask posts
    match /posts/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['done', 'ask']
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() <= 500
        && request.resource.data.up == 0 && request.resource.data.down == 0
        && request.resource.data.score == 0 && request.resource.data.comments == 0;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        // the owner edits content (and the helped mark, which only the owner may change)
        (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
          && request.resource.data.title.size() <= 80 && request.resource.data.body.size() <= 500)
        // anyone signed in adjusts the counters when voting or commenting
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up', 'down', 'score', 'comments'])
      );

      match /votes/{voter} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == voter && request.resource.data.v in [1, -1];
        allow delete: if request.auth != null && request.auth.uid == voter;
      }

      match /comments/{cid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 300;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }
  }
}
